---
// SPDX-License-Identifier: Apache-2.0
import '../styles/visual-explainers.css';
import {
  MEMORY_TRANSACTION_LIMITS,
  MEMORY_TRANSACTION_STATIC_CASES,
  createDefaultMemoryTransactionInput,
  groupMemoryByteRequests,
} from '../visuals/memory-transaction-model';
import { MEMORY_TRANSACTION_COPY, type MemoryVisualLocale } from '../visuals/memory-visual-copy';

interface Props {
  locale: MemoryVisualLocale;
}

const { locale } = Astro.props;
const copy = MEMORY_TRANSACTION_COPY[locale];
const defaultInput = createDefaultMemoryTransactionInput();
const initial = groupMemoryByteRequests(defaultInput);
if (!initial.valid) throw new Error('VIS04 default input must be valid.');
const staticCases = MEMORY_TRANSACTION_STATIC_CASES.map(({ id, input }) => {
  const result = groupMemoryByteRequests(input);
  if (!result.valid) throw new Error(`VIS04 static case ${id} must be valid.`);
  return { id, input, result };
});
const laneList = (lanes: readonly number[]) => lanes.join(', ');
const segmentList = (segments: readonly number[]) => segments.map((segment) => `[${segment}–${segment + 31}]`).join(', ');
---

<cuda-memory-transactions
  class="visual-explainer memory-visual not-content"
  data-visual-id="VIS04"
  data-locale={locale}
  data-valid="true"
  data-pattern="contiguous"
  data-segment-groups={initial.segments.length}
>
  <div class="visual-shell">
    <header class="visual-header">
      <p class="visual-eyebrow">{copy.eyebrow}</p>
      <h2>{copy.title}</h2>
      <p class="visual-summary">{copy.summary}</p>
    </header>

    <p class="visual-notice" data-conceptual-only>{copy.conceptualNotice}</p>

    <fieldset class="visual-controls memory-control-grid" data-visual-controls hidden>
      <legend>{copy.controlsLabel}</legend>
      <label>
        <span>{copy.pattern}</span>
        <select data-memory-pattern autocomplete="off" aria-label={copy.pattern}>
          <option value="contiguous" selected>{copy.patterns.contiguous}</option>
          <option value="strided">{copy.patterns.strided}</option>
        </select>
      </label>
      <label>
        <span>{copy.elementSize}</span>
        <select data-memory-field="elementSize" autocomplete="off" aria-label={copy.elementSize} aria-invalid="false">
          {MEMORY_TRANSACTION_LIMITS.elementSizes.map((size) => <option value={size} selected={size === 4}>{size}</option>)}
        </select>
      </label>
      <label>
        <span>{copy.stride}</span>
        <input data-memory-field="stride" type="number" inputmode="numeric" min="1" max={MEMORY_TRANSACTION_LIMITS.maxStrideElements} step="1" value={defaultInput.stride} autocomplete="off" aria-label={copy.stride} aria-invalid="false" disabled />
      </label>
      <label>
        <span>{copy.offset}</span>
        <input data-memory-field="offset" type="number" inputmode="numeric" min="0" max={MEMORY_TRANSACTION_LIMITS.maxOffsetBytes} step="1" value={defaultInput.offset} autocomplete="off" aria-label={copy.offset} aria-invalid="false" />
      </label>
      <label>
        <span>{copy.activeLanes}</span>
        <input data-memory-field="activeLanes" type="number" inputmode="numeric" min="1" max={MEMORY_TRANSACTION_LIMITS.maxActiveLanes} step="1" value={defaultInput.activeLanes} autocomplete="off" aria-label={copy.activeLanes} aria-invalid="false" />
      </label>
      <button type="button" data-reset-memory-transactions>{copy.reset}</button>
      <small>{copy.limits}</small>
    </fieldset>

    <p class="memory-validation" data-memory-validation role="status" aria-live="polite" aria-atomic="true" hidden></p>

    <section class="memory-workbench" data-interactive-workbench data-pagefind-ignore hidden aria-label={copy.result}>
      <header class="memory-result-header">
        <div>
          <span class="memory-result-kicker">{copy.result}</span>
          <strong data-memory-verdict>{initial.configuration.activeLanes} {copy.status} {initial.segments.length} {copy.segmentGroups}.</strong>
        </div>
        <p data-memory-status role="status" aria-live="polite" aria-atomic="true">
          {initial.configuration.activeLanes} {copy.status} {initial.segments.length} {copy.segmentGroups}.
        </p>
      </header>

      <dl class="memory-metrics">
        <div><dt>{copy.requestedBytes}</dt><dd data-requested-bytes>{initial.accounting.requestedBytes}</dd></div>
        <div><dt>{copy.coveredBytes}</dt><dd data-covered-bytes>{initial.accounting.coveredSegmentBytes}</dd></div>
        <div><dt>{copy.unusedBytes}</dt><dd data-unused-bytes>{initial.accounting.unusedSegmentBytes}</dd></div>
      </dl>

      <section class="memory-ledger-panel" aria-label={copy.segmentList}>
        <h3>{copy.segmentList}</h3>
        <ol class="memory-segment-list" data-memory-segments>
          {initial.segments.map((segment) => (
            <li data-segment-start={segment.startByte}>
              <strong>[{segment.startByte}–{segment.endByte}]</strong>
              <span>{copy.laneIds}: {laneList(segment.laneIds)}</span>
              <span>{copy.bytesInSegment}: {segment.requestedBytes}</span>
            </li>
          ))}
        </ol>
      </section>

      <div class="memory-table-wrap">
        <table class="memory-data-table">
          <caption>{copy.laneTable}</caption>
          <thead>
            <tr><th scope="col">{copy.lane}</th><th scope="col">{copy.addressRange}</th><th scope="col">{copy.segmentStarts}</th></tr>
          </thead>
          <tbody data-memory-lanes>
            {initial.lanes.map((lane) => (
              <tr data-lane={lane.lane}>
                <th scope="row">{lane.lane}</th>
                <td>[{lane.startByte}–{lane.endByte}]</td>
                <td>{segmentList(lane.segmentStarts)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="visual-section" data-static-fallback aria-label={copy.staticHeading}>
      <h3>{copy.staticHeading}</h3>
      <p class="visual-section-intro">{copy.staticIntro}</p>
      <div class="visual-static-grid memory-static-grid">
        {staticCases.map(({ id, result }) => (
          <article class="visual-static-card" data-static-case={id}>
            <h4>{copy.staticLabels[id]}</h4>
            <dl>
              <div><dt>{copy.segmentGroups}</dt><dd><strong>{result.segments.length}</strong></dd></div>
              <div><dt>{copy.requestedBytes}</dt><dd>{result.accounting.requestedBytes}</dd></div>
              <div><dt>{copy.coveredBytes}</dt><dd>{result.accounting.coveredSegmentBytes}</dd></div>
              <div><dt>{copy.unusedBytes}</dt><dd>{result.accounting.unusedSegmentBytes}</dd></div>
            </dl>
            <ol class="memory-static-segments">
              {result.segments.map((segment) => (
                <li>
                  <code>[{segment.startByte}–{segment.endByte}]</code>: {copy.laneIds} {laneList(segment.laneIds)}; {copy.bytesInSegment} {segment.requestedBytes}
                </li>
              ))}
            </ol>
          </article>
        ))}
      </div>
    </section>

    <p class="visual-evidence-notice" data-no-evidence>{copy.noEvidence}</p>
  </div>
</cuda-memory-transactions>

<script>
  import {
    createDefaultMemoryTransactionInput,
    groupMemoryByteRequests,
    isMemoryAccessPattern,
    type MemoryTransactionInput,
    type MemoryTransactionIssue,
  } from '../visuals/memory-transaction-model';
  import { MEMORY_TRANSACTION_COPY } from '../visuals/memory-visual-copy';

  type MemoryFieldKey = Exclude<keyof MemoryTransactionInput, 'pattern'>;
  const issueFields: Partial<Record<MemoryTransactionIssue, readonly MemoryFieldKey[]>> = {
    'element-size-invalid': ['elementSize'],
    'stride-invalid': ['stride'],
    'contiguous-stride-mismatch': ['stride'],
    'offset-invalid': ['offset'],
    'active-lanes-invalid': ['activeLanes'],
  };

  class CudaMemoryTransactions extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready === 'true') return;
      const controls = this.querySelector<HTMLFieldSetElement>('[data-visual-controls]');
      const workbench = this.querySelector<HTMLElement>('[data-interactive-workbench]');
      const pattern = this.querySelector<HTMLSelectElement>('[data-memory-pattern]');
      const reset = this.querySelector<HTMLButtonElement>('[data-reset-memory-transactions]');
      if (!controls || !workbench || !pattern || !reset || this.fields().size !== 4) return;

      this.dataset.ready = 'true';
      controls.hidden = false;
      workbench.hidden = false;
      pattern.addEventListener('change', () => {
        const stride = this.fields().get('stride');
        if (pattern.value === 'contiguous' && stride) stride.value = '1';
        this.render();
      });
      this.fields().forEach((field) => {
        field.addEventListener(field instanceof HTMLSelectElement ? 'change' : 'input', () => this.render());
      });
      reset.addEventListener('click', () => {
        const defaults = createDefaultMemoryTransactionInput();
        pattern.value = defaults.pattern;
        this.fields().forEach((field, key) => {
          field.value = defaults[key];
        });
        this.render();
        pattern.focus();
      });
      this.render();
    }

    private locale() {
      return this.dataset.locale === 'zh-CN' ? 'zh-CN' : 'en';
    }

    private fields() {
      const fields = new Map<MemoryFieldKey, HTMLInputElement | HTMLSelectElement>();
      this.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-memory-field]').forEach((field) => {
        const key = field.dataset.memoryField;
        if (key === 'elementSize' || key === 'stride' || key === 'offset' || key === 'activeLanes') {
          fields.set(key, field);
        }
      });
      return fields;
    }

    private render() {
      const pattern = this.querySelector<HTMLSelectElement>('[data-memory-pattern]');
      if (!pattern || !isMemoryAccessPattern(pattern.value)) return;
      const fields = this.fields();
      const values = Object.fromEntries([...fields].map(([key, field]) => [key, field.value]));
      const result = groupMemoryByteRequests({ pattern: pattern.value, ...values } as MemoryTransactionInput);
      const copy = MEMORY_TRANSACTION_COPY[this.locale()];
      const workbench = this.querySelector<HTMLElement>('[data-interactive-workbench]');
      const validation = this.querySelector<HTMLElement>('[data-memory-validation]');
      const stride = fields.get('stride');
      if (stride) stride.disabled = pattern.value === 'contiguous';
      fields.forEach((field) => field.setAttribute('aria-invalid', 'false'));

      if (!result.valid) {
        this.dataset.valid = 'false';
        if (workbench) workbench.hidden = true;
        for (const issue of result.issues) {
          for (const key of issueFields[issue] ?? []) fields.get(key)?.setAttribute('aria-invalid', 'true');
        }
        if (validation) {
          validation.hidden = false;
          validation.textContent = `${copy.invalid} ${result.issues.map((issue) => copy.issues[issue]).join(' ')}`;
        }
        return;
      }

      this.dataset.valid = 'true';
      this.dataset.pattern = result.configuration.pattern;
      this.dataset.segmentGroups = String(result.segments.length);
      if (workbench) workbench.hidden = false;
      if (validation) {
        validation.hidden = true;
        validation.textContent = '';
      }
      const status = `${result.configuration.activeLanes} ${copy.status} ${result.segments.length} ${copy.segmentGroups}.`;
      this.setText('[data-memory-verdict]', status);
      this.setText('[data-memory-status]', status);
      this.setText('[data-requested-bytes]', String(result.accounting.requestedBytes));
      this.setText('[data-covered-bytes]', String(result.accounting.coveredSegmentBytes));
      this.setText('[data-unused-bytes]', String(result.accounting.unusedSegmentBytes));

      const segmentList = this.querySelector<HTMLOListElement>('[data-memory-segments]');
      if (segmentList) {
        segmentList.replaceChildren(...result.segments.map((segment) => {
          const item = document.createElement('li');
          item.dataset.segmentStart = String(segment.startByte);
          const range = document.createElement('strong');
          range.textContent = `[${segment.startByte}–${segment.endByte}]`;
          const lanes = document.createElement('span');
          lanes.textContent = `${copy.laneIds}: ${segment.laneIds.join(', ')}`;
          const bytes = document.createElement('span');
          bytes.textContent = `${copy.bytesInSegment}: ${segment.requestedBytes}`;
          item.append(range, lanes, bytes);
          return item;
        }));
      }

      const laneTable = this.querySelector<HTMLTableSectionElement>('[data-memory-lanes]');
      if (laneTable) {
        laneTable.replaceChildren(...result.lanes.map((lane) => {
          const row = document.createElement('tr');
          row.dataset.lane = String(lane.lane);
          const laneCell = document.createElement('th');
          laneCell.scope = 'row';
          laneCell.textContent = String(lane.lane);
          const addressCell = document.createElement('td');
          addressCell.textContent = `[${lane.startByte}–${lane.endByte}]`;
          const segmentsCell = document.createElement('td');
          segmentsCell.textContent = lane.segmentStarts.map((start) => `[${start}–${start + 31}]`).join(', ');
          row.append(laneCell, addressCell, segmentsCell);
          return row;
        }));
      }
    }

    private setText(selector: string, value: string) {
      const element = this.querySelector<HTMLElement>(selector);
      if (element) element.textContent = value;
    }
  }

  if (!customElements.get('cuda-memory-transactions')) {
    customElements.define('cuda-memory-transactions', CudaMemoryTransactions);
  }
</script>
