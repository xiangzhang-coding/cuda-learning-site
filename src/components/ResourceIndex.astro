---
// SPDX-License-Identifier: Apache-2.0
import '../styles/resource-index.css';
import { RESOURCE_INDEX_RECORDS } from '../resource-indexes/resource-index-data';
import {
  INDEX_GROUPS,
  INDEX_LOCALES,
  projectResourceIndex,
  type IndexGroup,
  type IndexLocale,
} from '../resource-indexes/resource-index-model';
import {
  DIFFICULTY_LABELS,
  RESOURCE_INDEX_COPY,
  RESOURCE_TYPE_LABELS,
} from '../resource-indexes/resource-index-copy';

interface Props {
  group: IndexGroup;
  locale: IndexLocale;
}

const { group, locale } = Astro.props;
if (!INDEX_GROUPS.includes(group) || !INDEX_LOCALES.includes(locale)) {
  throw new Error(`Unsupported resource index coordinates: ${String(group)} / ${String(locale)}`);
}

const copy = RESOURCE_INDEX_COPY[locale];
const items = projectResourceIndex(RESOURCE_INDEX_RECORDS, group, locale);
const resourceTypes = [...new Set(items.map(({ resourceType }) => resourceType))].sort((left, right) =>
  RESOURCE_TYPE_LABELS[left][locale].localeCompare(RESOURCE_TYPE_LABELS[right][locale], locale),
);
const relations = [...new Set(items.flatMap(({ prerequisites, relatedUnits }) =>
  [...prerequisites, ...relatedUnits].map(({ id }) => id),
))].sort((left, right) => left.localeCompare(right, 'en', { numeric: true }));
const relationById = new Map(
  items.flatMap(({ prerequisites, relatedUnits }) =>
    [...prerequisites, ...relatedUnits].map((relation) => [relation.id, relation] as const),
  ),
);
const listRelations = (relations: readonly { id: string; href: string; title: string }[]) =>
  relations.length > 0 ? relations : undefined;
---

<cuda-resource-index
  class="resource-index not-content"
  data-resource-group={group}
  data-locale={locale}
  data-total={items.length}
  data-count-template={locale === 'zh-CN'
    ? '显示 {visible} / {total} 个已发布条目'
    : 'Showing {visible} of {total} published entries'}
>
  <div
    class="resource-index-controls"
    data-resource-controls
    data-pagefind-ignore="all"
    role="group"
    aria-label={copy.controlsLabel}
    hidden
  >
    <label class="resource-index-search">
      <span>{copy.searchLabel}</span>
      <input
        type="search"
        inputmode="search"
        autocomplete="off"
        placeholder={copy.searchPlaceholder}
        data-resource-query
      />
    </label>
    <label>
      <span>{copy.typeLabel}</span>
      <select data-resource-filter="type" autocomplete="off">
        <option value="">{copy.allTypes}</option>
        {resourceTypes.map((resourceType) => (
          <option value={resourceType}>{RESOURCE_TYPE_LABELS[resourceType][locale]}</option>
        ))}
      </select>
    </label>
    <label>
      <span>{copy.relationLabel}</span>
      <select data-resource-filter="relation" autocomplete="off">
        <option value="">{copy.allRelations}</option>
        {relations.map((unitId) => (
          <option value={unitId}>{relationById.get(unitId)?.title}</option>
        ))}
      </select>
    </label>
    <button type="button" data-action="reset-resource-filters">{copy.reset}</button>
    <p class="resource-index-count" data-resource-count role="status" aria-atomic="true">
      {copy.count(items.length, items.length)}
    </p>
  </div>

  <div class="resource-index-grid" data-resource-list>
    {items.map((item) => {
      const prerequisiteRelations = listRelations(item.prerequisites);
      const relatedUnitRelations = listRelations(item.relatedUnits);
      const relationIds = [...item.prerequisites, ...item.relatedUnits].map(({ id }) => id).join(' ');
      const typeLabel = RESOURCE_TYPE_LABELS[item.resourceType][locale];
      const difficultyLabel = item.difficulty ? DIFFICULTY_LABELS[item.difficulty][locale] : undefined;
      return (
        <article
          class="resource-index-card"
          data-resource-card
          data-resource-id={item.planningId}
          data-resource-type={item.resourceType}
          data-resource-relations={relationIds}
          data-resource-search={item.searchText}
          data-resource-counterpart={item.counterpart}
        >
          <header>
            <p class="resource-index-id">{item.planningId}</p>
            <h3><a href={item.href}>{item.title}</a></h3>
          </header>
          <dl>
            <div>
              <dt>{copy.resourceType}</dt>
              <dd>{typeLabel}</dd>
            </div>
            {difficultyLabel && (
              <div>
                <dt>{copy.difficulty}</dt>
                <dd>{difficultyLabel}</dd>
              </div>
            )}
            <div>
              <dt>{copy.prerequisites}</dt>
              <dd>
                {prerequisiteRelations
                  ? prerequisiteRelations.map((relation, index) => (
                    <><a href={relation.href}>{relation.id}</a>{index < prerequisiteRelations.length - 1 ? ', ' : ''}</>
                  ))
                  : copy.none}
              </dd>
            </div>
            <div>
              <dt>{copy.relatedUnits}</dt>
              <dd>
                {relatedUnitRelations
                  ? relatedUnitRelations.map((relation, index) => (
                    <><a href={relation.href}>{relation.id}</a>{index < relatedUnitRelations.length - 1 ? ', ' : ''}</>
                  ))
                  : copy.none}
              </dd>
            </div>
            <div>
              <dt>{copy.hardwareGate}</dt>
              <dd>{item.hardwareGate}</dd>
            </div>
            <div>
              <dt>{copy.versionGate}</dt>
              <dd>{item.versionGate}</dd>
            </div>
            {item.evidence && (
              <div data-resource-evidence>
                <dt>{copy.evidence}</dt>
                <dd>
                  <span data-evidence-compilation={item.evidence.compilation.join(',') || 'none'}>
                    {copy.compilation}: {item.evidence.compilation.join(', ') || copy.none}
                  </span>
                  {'; '}
                  <span data-evidence-runtime={item.evidence.runtime.join(',') || 'none'}>
                    {copy.runtime}: {item.evidence.runtime.join(', ') || copy.none}
                  </span>
                </dd>
              </div>
            )}
            {group === 'visuals' && (
              <div data-no-evidence>
                <dt>{copy.evidence}</dt>
                <dd>{copy.evidenceNotApplicable}</dd>
              </div>
            )}
            <div>
              <dt>{copy.reviewedOn}</dt>
              <dd><time datetime={item.reviewedOn}>{item.reviewedOn}</time></dd>
            </div>
            {item.sourceAccessDate && (
              <div>
                <dt>{copy.sourceAccessDate}</dt>
                <dd><time datetime={item.sourceAccessDate}>{item.sourceAccessDate}</time></dd>
              </div>
            )}
          </dl>
        </article>
      );
    })}
  </div>

  <p class="resource-index-empty" data-resource-empty role="status" aria-live="polite" hidden>
    {copy.noResults}
  </p>
</cuda-resource-index>

<script>
  class CudaResourceIndex extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready === 'true') return;
      const controls = this.querySelector<HTMLElement>('[data-resource-controls]');
      const query = this.querySelector<HTMLInputElement>('[data-resource-query]');
      const typeFilter = this.querySelector<HTMLSelectElement>('[data-resource-filter="type"]');
      const relationFilter = this.querySelector<HTMLSelectElement>('[data-resource-filter="relation"]');
      const reset = this.querySelector<HTMLButtonElement>('[data-action="reset-resource-filters"]');
      const count = this.querySelector<HTMLElement>('[data-resource-count]');
      const empty = this.querySelector<HTMLElement>('[data-resource-empty]');
      const cards = [...this.querySelectorAll<HTMLElement>('[data-resource-card]')];
      if (!controls || !query || !typeFilter || !relationFilter || !reset || !count || !empty) return;

      const locale = this.dataset.locale === 'zh-CN' ? 'zh-CN' : 'en';
      const normalize = (value: string) => value.normalize('NFKC').toLocaleLowerCase(locale).trim();
      const updateCount = (visible: number) => {
        const template = this.dataset.countTemplate ?? '{visible} / {total}';
        count.textContent = template
          .replace('{visible}', String(visible))
          .replace('{total}', String(cards.length));
      };
      const applyFilters = () => {
        const queryValue = normalize(query.value);
        const typeValue = typeFilter.value;
        const relationValue = relationFilter.value;
        let visible = 0;

        for (const card of cards) {
          const matchesQuery = !queryValue || normalize(card.dataset.resourceSearch ?? '').includes(queryValue);
          const matchesType = !typeValue || card.dataset.resourceType === typeValue;
          const relations = (card.dataset.resourceRelations ?? '').split(' ').filter(Boolean);
          const matchesRelation = !relationValue || relations.includes(relationValue);
          card.hidden = !(matchesQuery && matchesType && matchesRelation);
          if (!card.hidden) visible += 1;
        }

        empty.hidden = visible !== 0;
        updateCount(visible);
      };

      query.addEventListener('input', applyFilters);
      query.addEventListener('search', applyFilters);
      typeFilter.addEventListener('change', applyFilters);
      relationFilter.addEventListener('change', applyFilters);
      reset.addEventListener('click', () => {
        query.value = '';
        typeFilter.value = '';
        relationFilter.value = '';
        applyFilters();
        query.focus();
      });

      this.dataset.ready = 'true';
      controls.hidden = false;
      applyFilters();
    }
  }

  if (!customElements.get('cuda-resource-index')) {
    customElements.define('cuda-resource-index', CudaResourceIndex);
  }
</script>
