    notice: '教学范围：初始化与 device、context、module/function、memory、launch、completion/error。选择只改变解释，不执行 CUDA。',
    controls: '选择生命周期责任',
    selected: '已选择',
    runtime: 'Runtime API（入门路径）',
    driver: 'Driver API（比较边界）',
    calls: '代表性调用',
    handles: '可见 handle 或身份',
    management: '管理方式',
    shared: '共同边界',
