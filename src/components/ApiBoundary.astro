    status: '当前阶段 {current}/{total}：{stage}',
    staticTitle: '完整静态回退：层次与责任表',
    staticIntro: '即使脚本不可用，下面的语义图、完整表格和文字读法仍保留全部六个阶段。',
    application: 'Host 应用',
    runtimeLayer: 'Runtime API · cuda* · 较多隐式管理',
    driverLayer: 'Driver API · cu* · 显式 handle 与控制',
