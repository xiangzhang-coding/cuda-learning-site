---
// SPDX-License-Identifier: Apache-2.0
import {
  API_BOUNDARY_STAGES,
  createApiBoundaryState,
  getApiBoundaryStage,
  type ApiBoundaryStageId,
} from '../visuals/api-boundary-model';

interface Props {
  locale: 'zh-CN' | 'en';
}

const { locale } = Astro.props;
const copies = {
  'zh-CN': {
    eyebrow: 'F07 / API 边界模型',
    title: '同一驱动栈，不同的生命周期所有权',
