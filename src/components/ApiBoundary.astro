      'explicit-boundary': '显式检查/完成边界',
      explicit: '显式 handle 与调用',
    },
    stages: {
      'initialize-device': {
        label: '初始化与 device',
        runtime: '选择 device 时，由 Runtime 按需建立其较高层运行状态；通常不要求应用先取得 CUdevice handle。',
        driver: '应用先调用 cuInit，再用 device ordinal 取得 CUdevice；初始化与 device 身份属于显式控制流。',
        invariant: 'Device 选择不等于 kernel 已提交或完成。',
      },
      context: {
        label: 'Context',
        runtime: '若调用线程没有合适的 current Driver context，Runtime 通常按需使用 device 的 primary context。',
        driver: '应用选择 retain primary context 或创建 context，并负责 current-context 与生命周期规则。',
        invariant: '互操作取决于调用线程的 current context 与精确版本文档中的例外。',
      },
      'module-function': {
        label: 'Module 与 function',
        runtime: 'CUDA C++ 路径通常让 Runtime 隐式管理已注册的 device code 与 module，并通过 kernel symbol 发起 launch。',
        driver: '应用显式加载 module，再按名称取得 CUfunction，并决定 module 的保留与卸载边界。',
        invariant: '两种代码管理角色不同，不能据此建立逐调用一一映射。',
      },
      memory: {
        label: 'Memory',
        runtime: 'cudaMalloc/cudaMemcpy/cudaFree 仍要求应用记录 allocation、方向、last use 与 release。较高层 API 不消除资源 ownership。',
        driver: 'cuMemAlloc/cuMemcpy*/cuMemFree 使用 CUdeviceptr；应用同样承担 allocation、transfer 与 release 责任。',
        invariant: '成功取得的资源必须在对应 context 中保持有效，并在最后使用后释放。',
      },
      launch: {
        label: 'Launch',
        runtime: 'Runtime 接受 kernel symbol、execution configuration 与参数；CUDA C++ 还提供熟悉的尖括号 launch 语法。',
        driver: 'cuLaunchKernel 接受 CUfunction、显式 grid/block 配置和参数数组；function/module/context 必须已经有效。',
        invariant: '提交 launch 与建立完成是两个边界。',
      },
      'completion-errors': {
        label: '完成与错误',
        runtime: 'cudaError_t、launch 检查和 cudaDeviceSynchronize 等边界区分提交时错误与延后执行错误。',
        driver: 'Driver 调用返回 CUresult，并通过 context、stream 或 event 同步建立相应完成边界；某些调用也可能报告此前异步工作错误。',
        invariant: 'API 选择不会消除异步错误边界；必须检查提交与后续完成观察点。',
      },
    },
  },
  en: {
    eyebrow: 'F07 / API boundary model',
    title: 'One driver stack, different lifecycle ownership',
    summary: 'Compare Runtime API and Driver API responsibilities stage by stage within one bounded lifecycle. This is not an API crosswalk and does not imply one-to-one calls.',
    notice: 'Teaching scope: initialization and device, context, module/function, memory, launch, and completion/error. A selection changes only the explanation; it executes no CUDA.',
    controls: 'Select a lifecycle responsibility',
    selected: 'Selected',
    runtime: 'Runtime API (introductory path)',
    driver: 'Driver API (comparative boundary)',
    calls: 'Representative calls',
    handles: 'Visible handles or identities',
    management: 'Management mode',
    shared: 'Shared boundary',
    stack: 'Both host API paths enter the CUDA driver stack and then reach the device. This model does not draw each Runtime call as a same-named Driver wrapper.',
    status: 'Current stage {current}/{total}: {stage}',
    staticTitle: 'Complete static fallback: layers and responsibility table',
    staticIntro: 'If scripting is unavailable, the semantic diagram, complete table, and textual reading below still preserve all six stages.',
    application: 'Host application',
    runtimeLayer: 'Runtime API · cuda* · more implicit management',
    driverLayer: 'Driver API · cu* · explicit handles and control',
    driverStack: 'CUDA driver stack',
    device: 'CUDA device',
    stage: 'Stage',
    runtimeResponsibility: 'Runtime responsibility',
    driverResponsibility: 'Driver responsibility',
    invariant: 'Invariant boundary',
    reading: 'Textual reading: the Runtime path commonly establishes a primary context and manages modules implicitly; the Driver path explicitly initializes and obtains device, context, module, and function handles. Both paths leave buffer, parameter, completion-boundary, and error-checking responsibilities in the program. They may interoperate under documented context rules, but choosing either API does not turn an asynchronous launch into synchronous completion.',
    evidence: 'This browser composition loads no CUDA, submits no kernel, observes no GPU, and changes no evidence status for EX04 or any Lab. It grants no Compile-Checked, Community-Observed, or Runtime-Verified Evidence Status.',
    managementLabels: {
      'implicit-primary-context': 'Implicit primary-context management',
      'implicit-module': 'Implicit module management',
      'explicit-resource': 'Explicit resource responsibility',
      'higher-level-launch': 'Higher-level launch interface',
      'explicit-boundary': 'Explicit check/completion boundary',
      explicit: 'Explicit handles and calls',
    },
    stages: {
      'initialize-device': {
        label: 'Initialization and device',
        runtime: 'When a device is selected, the Runtime establishes its higher-level runtime state as needed; the application usually does not first acquire a CUdevice handle.',
        driver: 'The application calls cuInit, then resolves a device ordinal to CUdevice; initialization and device identity are explicit control flow.',
        invariant: 'Selecting a device says neither that a kernel was submitted nor that work completed.',
      },
      context: {
        label: 'Context',
        runtime: 'If the calling thread has no suitable current Driver context, the Runtime commonly uses the device primary context as needed.',
        driver: 'The application chooses to retain a primary context or create a context, then owns current-context and lifetime rules.',
        invariant: 'Interoperation depends on the calling thread current context and exceptions in the exact-version documentation.',
      },
      'module-function': {
        label: 'Module and function',
        runtime: 'The CUDA C++ path commonly lets the Runtime manage registered device code and modules implicitly and launches through a kernel symbol.',
        driver: 'The application explicitly loads a module, resolves a CUfunction by name, and chooses module retention and unload boundaries.',
        invariant: 'The code-management roles differ; they do not establish a call-by-call mapping.',
      },
      memory: {
        label: 'Memory',
        runtime: 'cudaMalloc/cudaMemcpy/cudaFree still require the application to track allocation, direction, last use, and release. A higher-level API does not erase resource ownership.',
        driver: 'cuMemAlloc/cuMemcpy*/cuMemFree use CUdeviceptr; the application has the same allocation, transfer, and release obligations.',
        invariant: 'An acquired resource must remain valid in its applicable context and be released after last use.',
      },
      launch: {
        label: 'Launch',
        runtime: 'The Runtime accepts a kernel symbol, execution configuration, and arguments; CUDA C++ also supplies the familiar angle-bracket launch syntax.',
        driver: 'cuLaunchKernel accepts a CUfunction, explicit grid/block configuration, and parameter array after function, module, and context are valid.',
        invariant: 'Launch submission and established completion are separate boundaries.',
      },
      'completion-errors': {
        label: 'Completion and errors',
        runtime: 'cudaError_t, launch checks, and boundaries such as cudaDeviceSynchronize separate submission-time errors from deferred execution errors.',
        driver: 'Driver calls return CUresult and use context, stream, or event synchronization for completion boundaries; some calls may also report errors from earlier asynchronous work.',
        invariant: 'API choice does not remove asynchronous error boundaries; check both submission and a later completion observation point.',
      },
    },
  },
} as const;
const copy = copies[locale];
const initialState = createApiBoundaryState();
const initialStage = getApiBoundaryStage(initialState.stageId);
const initialCopy = copy.stages[initialStage.id];
const panelId = `api-boundary-panel-${locale}`;
const tabId = (stageId: ApiBoundaryStageId) => `api-boundary-tab-${locale}-${stageId}`;
const codeList = (values: readonly string[]) => values.join(' · ');
---

<cuda-api-boundary class="api-boundary not-content" data-visual-id="VIS21" data-locale={locale} data-current-stage={initialStage.id}>
  <header class="api-boundary-header">
    <p>{copy.eyebrow}</p>
    <h3>{copy.title}</h3>
    <p data-conceptual-only>{copy.summary}</p>
  </header>

  <p class="api-boundary-notice">{copy.notice}</p>

  <div class="api-boundary-tabs" data-api-boundary-controls data-visual-controls hidden role="tablist" aria-label={copy.controls}>
    {API_BOUNDARY_STAGES.map((stage, index) => (
      <button
        id={tabId(stage.id)}
        type="button"
        role="tab"
        aria-selected={index === 0 ? 'true' : 'false'}
        aria-controls={panelId}
        tabindex={index === 0 ? 0 : -1}
        data-stage-tab={stage.id}
      >
        <span class="api-boundary-tab-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <span>{copy.stages[stage.id].label}</span>
        <span class="api-boundary-tab-state" data-tab-state>{index === 0 ? copy.selected : ''}</span>
      </button>
    ))}
  </div>

  <section
    id={panelId}
    class="api-boundary-current"
    data-api-boundary-panel
    hidden
    role="tabpanel"
    aria-labelledby={tabId(initialStage.id)}
    tabindex="0"
  >
    <p class="api-boundary-live" data-api-boundary-status role="status" aria-live="polite" aria-atomic="true">
      {copy.status.replace('{current}', '1').replace('{total}', String(API_BOUNDARY_STAGES.length)).replace('{stage}', initialCopy.label)}
    </p>
    <div class="api-boundary-compare">
      <article data-api-family="runtime">
        <p class="api-family-label">{copy.runtime}</p>
        <h4 data-stage-title>{initialCopy.label}</h4>
        <p data-runtime-responsibility>{initialCopy.runtime}</p>
        <dl>
          <div><dt>{copy.management}</dt><dd data-runtime-management>{copy.managementLabels[initialStage.runtime.management]}</dd></div>
          <div><dt>{copy.calls}</dt><dd><code data-runtime-calls>{codeList(initialStage.runtime.apis)}</code></dd></div>
          <div><dt>{copy.handles}</dt><dd><code data-runtime-handles>{codeList(initialStage.runtime.handles)}</code></dd></div>
        </dl>
      </article>
      <article data-api-family="driver">
        <p class="api-family-label">{copy.driver}</p>
        <h4 data-stage-title>{initialCopy.label}</h4>
        <p data-driver-responsibility>{initialCopy.driver}</p>
        <dl>
          <div><dt>{copy.management}</dt><dd data-driver-management>{copy.managementLabels[initialStage.driver.management]}</dd></div>
          <div><dt>{copy.calls}</dt><dd><code data-driver-calls>{codeList(initialStage.driver.apis)}</code></dd></div>
          <div><dt>{copy.handles}</dt><dd><code data-driver-handles>{codeList(initialStage.driver.handles)}</code></dd></div>
        </dl>
      </article>
    </div>
    <div class="api-boundary-shared">
      <strong>{copy.shared}</strong>
      <p data-shared-invariant>{initialCopy.invariant}</p>
      <p>{copy.stack}</p>
    </div>
  </section>

  <section class="api-boundary-static" data-static-fallback aria-label={copy.staticTitle}>
    <h4>{copy.staticTitle}</h4>
    <p>{copy.staticIntro}</p>
    <div class="api-layer-diagram" role="img" aria-label={`${copy.application}: ${copy.runtimeLayer} or ${copy.driverLayer}; ${copy.driverStack}; ${copy.device}.`}>
      <div class="api-layer-host">{copy.application}</div>
      <div class="api-layer-paths">
        <div><strong>Runtime</strong><span>{copy.runtimeLayer}</span></div>
        <div><strong>Driver</strong><span>{copy.driverLayer}</span></div>
      </div>
      <div class="api-layer-arrow" aria-hidden="true">↓</div>
      <div class="api-layer-driver">{copy.driverStack}</div>
      <div class="api-layer-arrow" aria-hidden="true">↓</div>
      <div class="api-layer-device">{copy.device}</div>
    </div>
    <div class="api-boundary-table-wrap" tabindex="0" aria-label={copy.staticTitle}>
      <table>
        <thead>
          <tr><th scope="col">{copy.stage}</th><th scope="col">{copy.runtimeResponsibility}</th><th scope="col">{copy.driverResponsibility}</th><th scope="col">{copy.invariant}</th></tr>
        </thead>
        <tbody>
          {API_BOUNDARY_STAGES.map((stage) => (
            <tr>
              <th scope="row">{copy.stages[stage.id].label}</th>
              <td><p>{copy.stages[stage.id].runtime}</p><code>{codeList(stage.runtime.apis)}</code></td>
              <td><p>{copy.stages[stage.id].driver}</p><code>{codeList(stage.driver.apis)}</code></td>
              <td>{copy.stages[stage.id].invariant}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="api-boundary-reading">{copy.reading}</p>
  </section>

  <p class="api-boundary-evidence" data-no-evidence>{copy.evidence}</p>
</cuda-api-boundary>

<script>
  import {
    API_BOUNDARY_STAGES,
    createApiBoundaryState,
    getApiBoundaryStage,
    reduceApiBoundary,
    type ApiBoundaryAction,
    type ApiBoundaryStageId,
    type ApiBoundaryState,
  } from '../visuals/api-boundary-model';

  class CudaApiBoundary extends HTMLElement {
    private state: ApiBoundaryState = createApiBoundaryState();

    connectedCallback() {
      if (this.dataset.ready === 'true') return;
      const controls = this.querySelector<HTMLElement>('[data-api-boundary-controls]');
      const panel = this.querySelector<HTMLElement>('[data-api-boundary-panel]');
      const tabs = [...this.querySelectorAll<HTMLButtonElement>('[data-stage-tab]')];
      if (!controls || !panel || tabs.length !== API_BOUNDARY_STAGES.length) return;

      this.dataset.ready = 'true';
      controls.hidden = false;
      panel.hidden = false;
      tabs.forEach((tab) => {
        tab.addEventListener('click', () => this.select(tab));
        tab.addEventListener('keydown', (event) => this.handleKeydown(event, tab));
      });
      this.render();
    }

    private select(tab: HTMLButtonElement) {
      const stageId = tab.dataset.stageTab;
      if (!this.isStageId(stageId)) return;
      this.apply({ type: 'select', stageId });
    }

    private handleKeydown(event: KeyboardEvent, tab: HTMLButtonElement) {
      const actions: Partial<Record<string, ApiBoundaryAction>> = {
        ArrowRight: { type: 'next' },
        ArrowDown: { type: 'next' },
        ArrowLeft: { type: 'previous' },
        ArrowUp: { type: 'previous' },
        Home: { type: 'first' },
        End: { type: 'last' },
      };
      const action = actions[event.key];
      if (!action) return;
      event.preventDefault();
      const stageId = tab.dataset.stageTab;
      if (this.isStageId(stageId) && this.state.stageId !== stageId) {
        this.state = createApiBoundaryState(stageId);
      }
      this.apply(action, true);
    }

    private apply(action: ApiBoundaryAction, moveFocus = false) {
      this.state = reduceApiBoundary(this.state, action);
      this.render();
      if (moveFocus) {
        this.querySelector<HTMLButtonElement>(`[data-stage-tab="${this.state.stageId}"]`)?.focus();
      }
    }

    private render() {
      const locale = this.dataset.locale === 'zh-CN' ? 'zh-CN' : 'en';
      const copy = this.copy(locale);
      const stage = getApiBoundaryStage(this.state.stageId);
      const stageCopy = copy.stages[stage.id];
      const stageIndex = API_BOUNDARY_STAGES.findIndex(({ id }) => id === stage.id);
      this.dataset.currentStage = stage.id;

      this.querySelectorAll<HTMLButtonElement>('[data-stage-tab]').forEach((tab) => {
        const selected = tab.dataset.stageTab === stage.id;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        const state = tab.querySelector<HTMLElement>('[data-tab-state]');
        if (state) state.textContent = selected ? copy.selected : '';
      });

      const panel = this.querySelector<HTMLElement>('[data-api-boundary-panel]');
      const activeTab = this.querySelector<HTMLButtonElement>(`[data-stage-tab="${stage.id}"]`);
      if (panel && activeTab?.id) panel.setAttribute('aria-labelledby', activeTab.id);
      this.setText('[data-api-boundary-status]', copy.status
        .replace('{current}', String(stageIndex + 1))
        .replace('{total}', String(API_BOUNDARY_STAGES.length))
        .replace('{stage}', stageCopy.label));
      this.querySelectorAll<HTMLElement>('[data-stage-title]').forEach((title) => { title.textContent = stageCopy.label; });
      this.setText('[data-runtime-responsibility]', stageCopy.runtime);
      this.setText('[data-driver-responsibility]', stageCopy.driver);
      this.setText('[data-runtime-management]', copy.managementLabels[stage.runtime.management]);
      this.setText('[data-driver-management]', copy.managementLabels[stage.driver.management]);
      this.setText('[data-runtime-calls]', stage.runtime.apis.join(' · '));
      this.setText('[data-driver-calls]', stage.driver.apis.join(' · '));
      this.setText('[data-runtime-handles]', stage.runtime.handles.join(' · '));
      this.setText('[data-driver-handles]', stage.driver.handles.join(' · '));
      this.setText('[data-shared-invariant]', stageCopy.invariant);
    }

    private setText(selector: string, value: string) {
      const element = this.querySelector<HTMLElement>(selector);
      if (element) element.textContent = value;
    }

    private isStageId(value: string | undefined): value is ApiBoundaryStageId {
      return API_BOUNDARY_STAGES.some(({ id }) => id === value);
    }

    private copy(locale: 'zh-CN' | 'en') {
      const labels = {
        'zh-CN': {
          selected: '已选择',
          status: '当前阶段 {current}/{total}：{stage}',
          managementLabels: {
            'implicit-primary-context': '隐式 primary-context 管理',
            'implicit-module': '隐式 module 管理',
            'explicit-resource': '显式资源责任',
            'higher-level-launch': '较高层 launch 接口',
            'explicit-boundary': '显式检查/完成边界',
            explicit: '显式 handle 与调用',
          },
          stages: {
            'initialize-device': { label: '初始化与 device', runtime: '选择 device 时，由 Runtime 按需建立其较高层运行状态；通常不要求应用先取得 CUdevice handle。', driver: '应用先调用 cuInit，再用 device ordinal 取得 CUdevice；初始化与 device 身份属于显式控制流。', invariant: 'Device 选择不等于 kernel 已提交或完成。' },
            context: { label: 'Context', runtime: '若调用线程没有合适的 current Driver context，Runtime 通常按需使用 device 的 primary context。', driver: '应用选择 retain primary context 或创建 context，并负责 current-context 与生命周期规则。', invariant: '互操作取决于调用线程的 current context 与精确版本文档中的例外。' },
            'module-function': { label: 'Module 与 function', runtime: 'CUDA C++ 路径通常让 Runtime 隐式管理已注册的 device code 与 module，并通过 kernel symbol 发起 launch。', driver: '应用显式加载 module，再按名称取得 CUfunction，并决定 module 的保留与卸载边界。', invariant: '两种代码管理角色不同，不能据此建立逐调用一一映射。' },
            memory: { label: 'Memory', runtime: 'cudaMalloc/cudaMemcpy/cudaFree 仍要求应用记录 allocation、方向、last use 与 release。较高层 API 不消除资源 ownership。', driver: 'cuMemAlloc/cuMemcpy*/cuMemFree 使用 CUdeviceptr；应用同样承担 allocation、transfer 与 release 责任。', invariant: '成功取得的资源必须在对应 context 中保持有效，并在最后使用后释放。' },
            launch: { label: 'Launch', runtime: 'Runtime 接受 kernel symbol、execution configuration 与参数；CUDA C++ 还提供熟悉的尖括号 launch 语法。', driver: 'cuLaunchKernel 接受 CUfunction、显式 grid/block 配置和参数数组；function/module/context 必须已经有效。', invariant: '提交 launch 与建立完成是两个边界。' },
            'completion-errors': { label: '完成与错误', runtime: 'cudaError_t、launch 检查和 cudaDeviceSynchronize 等边界区分提交时错误与延后执行错误。', driver: 'Driver 调用返回 CUresult，并通过 context、stream 或 event 同步建立相应完成边界；某些调用也可能报告此前异步工作错误。', invariant: 'API 选择不会消除异步错误边界；必须检查提交与后续完成观察点。' },
          },
        },
        en: {
          selected: 'Selected',
          status: 'Current stage {current}/{total}: {stage}',
          managementLabels: {
            'implicit-primary-context': 'Implicit primary-context management',
            'implicit-module': 'Implicit module management',
            'explicit-resource': 'Explicit resource responsibility',
            'higher-level-launch': 'Higher-level launch interface',
            'explicit-boundary': 'Explicit check/completion boundary',
            explicit: 'Explicit handles and calls',
          },
          stages: {
            'initialize-device': { label: 'Initialization and device', runtime: 'When a device is selected, the Runtime establishes its higher-level runtime state as needed; the application usually does not first acquire a CUdevice handle.', driver: 'The application calls cuInit, then resolves a device ordinal to CUdevice; initialization and device identity are explicit control flow.', invariant: 'Selecting a device says neither that a kernel was submitted nor that work completed.' },
            context: { label: 'Context', runtime: 'If the calling thread has no suitable current Driver context, the Runtime commonly uses the device primary context as needed.', driver: 'The application chooses to retain a primary context or create a context, then owns current-context and lifetime rules.', invariant: 'Interoperation depends on the calling thread current context and exceptions in the exact-version documentation.' },
