---
// SPDX-License-Identifier: Apache-2.0
import '../styles/visual-explainers.css';
import '../styles/compilation-visuals.css';
import {
  ARTIFACT_PIPELINE_COPY,
  formatArtifactPipelineCopy,
  type ArtifactPipelineLocale,
} from '../visuals/artifact-pipeline-copy';
import {
  ARTIFACT_PIPELINE_MODEL_CONTRACT,
  ARTIFACT_PIPELINE_MODES,
  ARTIFACT_PIPELINE_REVIEWED_SELECTIONS,
  ARTIFACT_PIPELINE_TOOLKIT_LANES,
  createArtifactPipelineState,
  deriveArtifactPipelineFrame,
  deriveArtifactPipelineFrames,
  getArtifactPipelineTargetPlans,
  type ArtifactPipelineFrame,
  type ArtifactPipelineStageId,
} from '../visuals/artifact-pipeline-model';

interface Props {
  locale: ArtifactPipelineLocale;
}

const { locale } = Astro.props;
const copy = ARTIFACT_PIPELINE_COPY[locale];
const initialState = createArtifactPipelineState();
const initialFrameResult = deriveArtifactPipelineFrame(initialState);
if (!initialFrameResult.accepted) throw new Error('VIS09 initial model state must be valid.');
const initialFrame = initialFrameResult.frame;
const initialTargetPlans = getArtifactPipelineTargetPlans(initialState.lane);
const staticSelections = ARTIFACT_PIPELINE_REVIEWED_SELECTIONS.map((selection) => {
  const result = deriveArtifactPipelineFrames(selection.lane, selection.targetPlanId, selection.mode);
  if (!result.accepted) {
    throw new Error(`VIS09 static selection ${selection.lane}:${selection.targetPlanId}:${selection.mode} must be valid.`);
  }
  const finalFrame = result.frames.at(-1);
  if (!finalFrame) throw new Error('VIS09 static selection must contain a final frame.');
  return finalFrame;
});

function frameValues(frame: ArtifactPipelineFrame) {
  const shared = {
    lane: frame.lane,
    plan: copy.targetPlans[frame.targetPlan.id].title,
    mode: copy.modes[frame.mode].title,
    scope: copy.targetScopes[frame.targetPlan.targetScope],
    virtual: frame.manifest.virtualTarget,
    real: frame.manifest.realTarget,
  };

  if (frame.manifest.pipelineMode === 'whole-program') {
    return {
      ...shared,
      source: frame.manifest.source,
      sourceInputs: frame.manifest.source,
      hostObject: frame.manifest.hostObject.object,
      hostObjects: `${frame.manifest.hostObject.object} [${frame.manifest.hostObject.embeddedDeviceCode}]`,
      deviceLinkObject: `${frame.manifest.deviceLink.state} · object: none`,
      finalInputs: frame.manifest.finalHostLink.inputs.join(' + '),
      ptx: frame.manifest.ptxImage,
      cubin: frame.manifest.cubinImage,
      callerSource: '',
      deviceMathSource: '',
      callerObject: '',
      deviceMathObject: '',
      callerRdc: '',
      deviceMathRdc: '',
      linkedDeviceCode: '',
    };
  }

  const [caller, deviceMath] = frame.manifest.translationUnits;
  return {
    ...shared,
    source: `${caller.source} + ${deviceMath.source}`,
    sourceInputs: `${caller.source} + ${deviceMath.source}`,
    hostObject: `${caller.hostObject} + ${deviceMath.hostObject}`,
    hostObjects: `${caller.hostObject} [${caller.relocatableDeviceCode}] · ${deviceMath.hostObject} [${deviceMath.relocatableDeviceCode}]`,
    deviceLinkObject: `${frame.manifest.deviceLink.object} [${frame.manifest.deviceLink.linkedExecutableDeviceCode}]`,
    finalInputs: frame.manifest.finalHostLink.inputs.join(' + '),
    ptx: '',
    cubin: '',
    callerSource: caller.source,
    deviceMathSource: deviceMath.source,
    callerObject: caller.hostObject,
    deviceMathObject: deviceMath.hostObject,
    callerRdc: caller.relocatableDeviceCode,
    deviceMathRdc: deviceMath.relocatableDeviceCode,
    linkedDeviceCode: frame.manifest.deviceLink.linkedExecutableDeviceCode,
  };
}

const initialValues = frameValues(initialFrame);

function stageText(frame: ArtifactPipelineFrame, stageId: ArtifactPipelineStageId, field: 'description' | 'artifact') {
  const template = copy.modeStages[frame.mode][stageId][field];
  return formatArtifactPipelineCopy(template, frameValues(frame));
}
---

<cuda-artifact-pipeline
  class="visual-explainer artifact-pipeline-visual not-content"
  data-visual-id="VIS09"
  data-locale={locale}
  data-toolkit-lane={initialState.lane}
  data-target-plan={initialState.targetPlanId}
  data-pipeline-mode={initialState.mode}
  data-step-index={initialState.stepIndex}
  data-current-stage={initialFrame.currentStage?.id}
  data-sequence-complete="false"
  data-model-id={ARTIFACT_PIPELINE_MODEL_CONTRACT.modelId}
  data-runtime-image-selection={ARTIFACT_PIPELINE_MODEL_CONTRACT.runtimeImageSelection}
  data-evidence-status-effect={ARTIFACT_PIPELINE_MODEL_CONTRACT.evidenceStatusEffect}
>
  <div class="visual-shell">
    <header class="visual-header">
      <p class="visual-eyebrow">{copy.eyebrow}</p>
      <h2>{copy.title}</h2>
      <p class="visual-summary">{copy.summary}</p>
    </header>

    <p class="visual-notice" data-conceptual-only>{copy.conceptualNotice}</p>

    <section class="artifact-pipeline-boundary" data-model-boundary={ARTIFACT_PIPELINE_MODEL_CONTRACT.flowMeaning}>
      <h3>{copy.modelHeading}</h3>
      <ul>
        {copy.modelBoundaries.map((boundary) => <li>{boundary}</li>)}
      </ul>
    </section>

    <div class="visual-controls artifact-pipeline-controls" data-visual-controls hidden>
      <fieldset class="artifact-pipeline-control-set">
        <legend>{copy.controlsHeading}</legend>
        <label>
          <span>{copy.laneLabel}</span>
          <select data-artifact-lane aria-label={copy.laneLabel}>
            {ARTIFACT_PIPELINE_TOOLKIT_LANES.map((lane) => (
              <option value={lane} selected={lane === initialState.lane}>{lane}</option>
            ))}
          </select>
        </label>
        <label>
          <span>{copy.targetPlanLabel}</span>
          <select data-artifact-target-plan aria-label={copy.targetPlanLabel}>
            {initialTargetPlans.map((plan) => (
              <option value={plan.id} selected={plan.id === initialState.targetPlanId}>
                {copy.targetPlans[plan.id].title}
              </option>
            ))}
          </select>
        </label>
        <label>
          <span>{copy.modeLabel}</span>
          <select data-artifact-mode aria-label={copy.modeLabel}>
            {ARTIFACT_PIPELINE_MODES.map((mode) => (
              <option value={mode} selected={mode === initialState.mode}>{copy.modes[mode].title}</option>
            ))}
          </select>
        </label>
        <button type="button" data-artifact-action="step">{copy.step}</button>
        <button type="button" data-artifact-action="reset">{copy.reset}</button>
      </fieldset>
      <p
        class="artifact-pipeline-status"
        data-artifact-status
        role="status"
        aria-live="polite"
        aria-atomic="true"
      >
        {copy.statusReady}
      </p>
    </div>

    <section
      class="artifact-pipeline-workbench"
      data-live-workbench
      data-pagefind-ignore
      hidden
      aria-label={copy.workbenchHeading}
    >
      <header class="artifact-pipeline-selection">
        <div>
          <span>{copy.selectionLabel}</span>
          <h3>{copy.workbenchHeading}</h3>
        </div>
        <p data-selection-summary>{initialFrame.lane} · {copy.targetPlans[initialFrame.targetPlan.id].title} · {copy.modes[initialFrame.mode].title}</p>
        <p data-selection-description>{copy.targetPlans[initialFrame.targetPlan.id].description} {copy.modes[initialFrame.mode].description}</p>
      </header>

      <section class="artifact-pipeline-target-contract">
        <h4>{copy.targetContractHeading}</h4>
        <dl>
          <div>
            <dt>{copy.lane}</dt>
            <dd data-manifest-lane>{initialFrame.lane}</dd>
          </div>
          <div>
            <dt>{copy.pipelineMode}</dt>
            <dd data-manifest-mode>{copy.modes[initialFrame.mode].title}</dd>
          </div>
          <div>
            <dt>{copy.targetScope}</dt>
            <dd data-manifest-scope>{copy.targetScopes[initialFrame.targetPlan.targetScope]}</dd>
          </div>
          <div>
            <dt>{copy.virtualTarget}</dt>
            <dd><code data-manifest-virtual>{initialFrame.manifest.virtualTarget}</code></dd>
          </div>
          <div>
            <dt>{copy.realTarget}</dt>
            <dd><code data-manifest-real>{initialFrame.manifest.realTarget}</code></dd>
          </div>
          <div data-manifest-whole-program>
            <dt>{copy.ptxImage}</dt>
            <dd><code data-manifest-ptx>{initialValues.ptx}</code></dd>
          </div>
          <div data-manifest-whole-program>
            <dt>{copy.cubinImage}</dt>
            <dd><code data-manifest-cubin>{initialValues.cubin} · SASS</code></dd>
          </div>
          <div>
            <dt>{copy.sourceInputs}</dt>
            <dd><code data-manifest-sources>{initialValues.sourceInputs}</code></dd>
          </div>
          <div>
            <dt>{copy.hostObjects}</dt>
            <dd><code data-manifest-objects>{initialValues.hostObjects}</code></dd>
          </div>
          <div>
            <dt>{copy.deviceLinkObject}</dt>
            <dd><code data-manifest-device-link>{initialValues.deviceLinkObject}</code></dd>
          </div>
          <div>
            <dt>{copy.finalHostLinkInputs}</dt>
            <dd><code data-manifest-final-inputs>{initialValues.finalInputs}</code></dd>
          </div>
        </dl>
      </section>

      <section class="artifact-pipeline-flow-panel">
        <h4>{copy.flowHeading}</h4>
        <ol class="artifact-pipeline-flow" data-live-stage-list>
          {initialFrame.stages.map((stage, index) => (
            <li
              data-live-stage={stage.id}
              data-stage-identity={stage.identity}
              data-stage-mode={stage.mode}
              data-branch={stage.branch}
              data-stage-state={stage.state}
              data-optional={String(stage.optional)}
              aria-current={stage.state === 'current' ? 'step' : undefined}
            >
              <span class="artifact-pipeline-step-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <span class="artifact-pipeline-branch" data-stage-branch-label>{copy.branchLabels[stage.branch]}</span>
              <strong data-stage-label>{copy.modeStages[initialFrame.mode][stage.id].label}</strong>
              <p data-stage-description>{stageText(initialFrame, stage.id, 'description')}</p>
              <span class="artifact-pipeline-output-label">{copy.artifactOutput}</span>
              <code data-stage-artifact>{stageText(initialFrame, stage.id, 'artifact')}</code>
              <span class="artifact-pipeline-stage-state" data-stage-state-label>{copy.stageStates[stage.state]}</span>
            </li>
          ))}
        </ol>
      </section>

      <p class="artifact-pipeline-runtime" data-runtime-selection="unknown">
        <strong>{copy.runtimeSelection}: <span data-runtime-selection-value>{copy.runtimeSelectionUnknown}</span></strong>
        <span>{copy.runtimeSelectionBoundary}</span>
      </p>
    </section>

    <section class="visual-section artifact-pipeline-static" data-static-fallback aria-label={copy.staticHeading}>
      <h3>{copy.staticHeading}</h3>
      <p class="visual-section-intro">{copy.staticIntro}</p>
      <div class="artifact-pipeline-static-grid">
        {staticSelections.map((frame) => {
          const values = frameValues(frame);
          return (
          <article
            data-static-selection={`${frame.lane}:${frame.targetPlan.id}:${frame.mode}`}
            data-static-lane={frame.lane}
            data-static-target-plan={frame.targetPlan.id}
            data-static-mode={frame.mode}
            data-runtime-image-selection={frame.manifest.runtimeImageSelection}
          >
            <header>
              <p>{formatArtifactPipelineCopy(copy.staticCardKicker, frameValues(frame))}</p>
              <h4>{copy.targetPlans[frame.targetPlan.id].title}</h4>
              <p>{copy.targetPlans[frame.targetPlan.id].description} {copy.modes[frame.mode].description}</p>
            </header>

            <dl class="artifact-pipeline-static-manifest">
              <div>
                <dt>{copy.pipelineMode}</dt>
                <dd>{copy.modes[frame.mode].title}</dd>
              </div>
              <div>
                <dt>{copy.virtualTarget}</dt>
                <dd><code>{frame.manifest.virtualTarget}</code></dd>
              </div>
              <div>
                <dt>{copy.realTarget}</dt>
                <dd><code>{frame.manifest.realTarget}</code></dd>
              </div>
              {frame.manifest.pipelineMode === 'whole-program' && (
                <div>
                  <dt>{copy.ptxImage}</dt>
                  <dd><code>{frame.manifest.ptxImage}</code></dd>
                </div>
              )}
              {frame.manifest.pipelineMode === 'whole-program' && (
                <div>
                  <dt>{copy.cubinImage}</dt>
                  <dd><code>{frame.manifest.cubinImage} · {frame.manifest.cubinPayload}</code></dd>
                </div>
              )}
              <div>
                <dt>{copy.sourceInputs}</dt>
                <dd><code data-static-manifest-sources>{values.sourceInputs}</code></dd>
              </div>
              <div>
                <dt>{copy.hostObjects}</dt>
                <dd><code data-static-manifest-objects>{values.hostObjects}</code></dd>
              </div>
              <div>
                <dt>{copy.deviceLinkObject}</dt>
                <dd><code data-static-manifest-device-link>{values.deviceLinkObject}</code></dd>
              </div>
              <div>
                <dt>{copy.finalHostLinkInputs}</dt>
                <dd><code data-static-manifest-final-inputs>{values.finalInputs}</code></dd>
              </div>
            </dl>

            <section>
              <h5>{copy.staticFlowHeading}</h5>
              <ol class="artifact-pipeline-static-flow">
                {frame.stages.map((stage, index) => (
                  <li
                    data-static-stage={`${frame.lane}:${frame.targetPlan.id}:${frame.mode}:${stage.id}`}
                    data-stage-id={stage.id}
                    data-stage-identity={stage.identity}
                    data-stage-mode={stage.mode}
                    data-branch={stage.branch}
                    data-optional={String(stage.optional)}
                    data-stage-state={stage.state}
                  >
                    <span class="artifact-pipeline-step-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                    <span class="artifact-pipeline-branch">{copy.branchLabels[stage.branch]}</span>
                    <strong>{copy.modeStages[frame.mode][stage.id].label}</strong>
                    <p>{stageText(frame, stage.id, 'description')}</p>
                    <span class="artifact-pipeline-output-label">{copy.artifactOutput}</span>
                    <code>{stageText(frame, stage.id, 'artifact')}</code>
                    <span class="artifact-pipeline-stage-state" data-static-stage-state-label>{copy.stageStates[stage.state]}</span>
                  </li>
                ))}
              </ol>
            </section>

            <p class="artifact-pipeline-runtime" data-static-runtime-selection="unknown">
              <strong>{copy.runtimeSelection}: {copy.runtimeSelectionUnknown}</strong>
              <span>{copy.runtimeSelectionBoundary}</span>
            </p>
          </article>
          );
        })}
      </div>
    </section>

    <p class="visual-evidence-notice" data-no-evidence>{copy.noEvidence}</p>
  </div>
</cuda-artifact-pipeline>

<script>
  import {
    ARTIFACT_PIPELINE_COPY,
    formatArtifactPipelineCopy,
  } from '../visuals/artifact-pipeline-copy';
  import {
    ARTIFACT_PIPELINE_STAGE_IDS,
    createArtifactPipelineState,
    deriveArtifactPipelineFrame,
    getArtifactPipelineTargetPlans,
    reduceArtifactPipelineState,
    type ArtifactPipelineFrame,
    type ArtifactPipelineStageId,
    type ArtifactPipelineState,
  } from '../visuals/artifact-pipeline-model';

  class CudaArtifactPipeline extends HTMLElement {
    private state: ArtifactPipelineState = createArtifactPipelineState();

    connectedCallback() {
      if (this.dataset.ready === 'true') return;
      const controls = this.querySelector<HTMLElement>('[data-visual-controls]');
      const workbench = this.querySelector<HTMLElement>('[data-live-workbench]');
      const lane = this.querySelector<HTMLSelectElement>('[data-artifact-lane]');
      const targetPlan = this.querySelector<HTMLSelectElement>('[data-artifact-target-plan]');
      const mode = this.querySelector<HTMLSelectElement>('[data-artifact-mode]');
      const step = this.querySelector<HTMLButtonElement>('[data-artifact-action="step"]');
      const reset = this.querySelector<HTMLButtonElement>('[data-artifact-action="reset"]');
      const status = this.querySelector<HTMLElement>('[data-artifact-status]');
      const stages = this.querySelectorAll<HTMLElement>('[data-live-stage]');
      if (!controls || !workbench || !lane || !targetPlan || !mode || !step || !reset || !status) return;
      if (stages.length !== ARTIFACT_PIPELINE_STAGE_IDS.length) return;
      const requiredLiveSelectors = [
        '[data-selection-summary]',
        '[data-selection-description]',
        '[data-manifest-lane]',
        '[data-manifest-mode]',
        '[data-manifest-scope]',
        '[data-manifest-virtual]',
        '[data-manifest-real]',
        '[data-manifest-ptx]',
        '[data-manifest-cubin]',
        '[data-manifest-sources]',
        '[data-manifest-objects]',
        '[data-manifest-device-link]',
        '[data-manifest-final-inputs]',
        '[data-runtime-selection-value]',
      ];
      const requiredStageSelectors = [
        '[data-stage-label]',
        '[data-stage-branch-label]',
        '[data-stage-description]',
        '[data-stage-artifact]',
        '[data-stage-state-label]',
      ];
      if (requiredLiveSelectors.some((selector) => !workbench.querySelector(selector))) return;
      if ([...stages].some((stage) =>
        requiredStageSelectors.some((selector) => !stage.querySelector(selector)))) return;
      if (!this.renderTargetPlanOptions(targetPlan)) return;
      if (!this.render()) return;

      lane.addEventListener('change', () => {
        const update = reduceArtifactPipelineState(this.state, {
          type: 'select-lane',
          lane: lane.value,
        });
        if (!update.accepted) {
          lane.value = this.state.lane;
          this.announce(this.copy().issues[update.issue], true);
          return;
        }
        this.state = update.state;
        if (!this.renderTargetPlanOptions(targetPlan)) return;
        const frame = this.render();
        if (!frame) return;
        this.announce(this.format(this.copy().statusLane, frame), false);
      });

      targetPlan.addEventListener('change', () => {
        const update = reduceArtifactPipelineState(this.state, {
          type: 'select-target-plan',
          targetPlanId: targetPlan.value,
        });
        if (!update.accepted) {
          targetPlan.value = this.state.targetPlanId;
          this.announce(this.copy().issues[update.issue], true);
          return;
        }
        this.state = update.state;
        const frame = this.render();
        if (!frame) return;
        this.announce(this.format(this.copy().statusTargetPlan, frame), false);
      });

      mode.addEventListener('change', () => {
        const update = reduceArtifactPipelineState(this.state, {
          type: 'select-mode',
          mode: mode.value,
        });
        if (!update.accepted) {
          mode.value = this.state.mode;
          this.announce(this.copy().issues[update.issue], true);
          return;
        }
        this.state = update.state;
        const frame = this.render();
        if (!frame) return;
        this.announce(this.format(this.copy().statusMode, frame), false);
      });

      step.addEventListener('click', () => {
        const update = reduceArtifactPipelineState(this.state, { type: 'step' });
        if (!update.accepted) {
          this.announce(this.copy().issues[update.issue], true);
          return;
        }
        this.state = update.state;
        const frame = this.render();
        if (!frame) return;
        const completedStage = frame.stages.filter(({ state }) => state === 'complete').at(-1);
        if (!completedStage) {
          this.announce(this.copy().issues['invalid-state'], true);
          return;
        }
        const next = frame.sequenceComplete || !frame.currentStage
          ? this.copy().sequenceComplete
          : `${this.copy().stageStates.current}: ${this.copy().modeStages[frame.mode][frame.currentStage.id].label}.`;
        this.announce(this.format(this.copy().statusStep, frame, {
          current: String(frame.stepIndex),
          total: String(frame.stageCount),
          stage: this.copy().modeStages[frame.mode][completedStage.id].label,
          next,
        }), false);
      });

      reset.addEventListener('click', () => {
        const update = reduceArtifactPipelineState(this.state, { type: 'reset' });
        if (!update.accepted) {
          this.announce(this.copy().issues[update.issue], true);
          return;
        }
        this.state = update.state;
        if (!this.render()) return;
        this.announce(this.copy().statusReset, false);
        lane.focus();
      });

      this.dataset.ready = 'true';
      controls.hidden = false;
      workbench.hidden = false;
    }

    private copy() {
      return ARTIFACT_PIPELINE_COPY[this.dataset.locale === 'zh-CN' ? 'zh-CN' : 'en'];
    }

    private values(frame: ArtifactPipelineFrame) {
      const copy = this.copy();
      const shared = {
        lane: frame.lane,
        plan: copy.targetPlans[frame.targetPlan.id].title,
        mode: copy.modes[frame.mode].title,
        scope: copy.targetScopes[frame.targetPlan.targetScope],
        virtual: frame.manifest.virtualTarget,
        real: frame.manifest.realTarget,
      };

      if (frame.manifest.pipelineMode === 'whole-program') {
        return {
          ...shared,
          source: frame.manifest.source,
          sourceInputs: frame.manifest.source,
          hostObject: frame.manifest.hostObject.object,
          hostObjects: `${frame.manifest.hostObject.object} [${frame.manifest.hostObject.embeddedDeviceCode}]`,
          deviceLinkObject: `${frame.manifest.deviceLink.state} · object: none`,
          finalInputs: frame.manifest.finalHostLink.inputs.join(' + '),
          ptx: frame.manifest.ptxImage,
          cubin: frame.manifest.cubinImage,
          callerSource: '',
          deviceMathSource: '',
          callerObject: '',
          deviceMathObject: '',
          callerRdc: '',
          deviceMathRdc: '',
          linkedDeviceCode: '',
        };
      }

      const [caller, deviceMath] = frame.manifest.translationUnits;
      return {
        ...shared,
        source: `${caller.source} + ${deviceMath.source}`,
        sourceInputs: `${caller.source} + ${deviceMath.source}`,
        hostObject: `${caller.hostObject} + ${deviceMath.hostObject}`,
        hostObjects: `${caller.hostObject} [${caller.relocatableDeviceCode}] · ${deviceMath.hostObject} [${deviceMath.relocatableDeviceCode}]`,
        deviceLinkObject: `${frame.manifest.deviceLink.object} [${frame.manifest.deviceLink.linkedExecutableDeviceCode}]`,
        finalInputs: frame.manifest.finalHostLink.inputs.join(' + '),
        ptx: '',
        cubin: '',
        callerSource: caller.source,
        deviceMathSource: deviceMath.source,
        callerObject: caller.hostObject,
        deviceMathObject: deviceMath.hostObject,
        callerRdc: caller.relocatableDeviceCode,
        deviceMathRdc: deviceMath.relocatableDeviceCode,
        linkedDeviceCode: frame.manifest.deviceLink.linkedExecutableDeviceCode,
      };
    }

    private format(
      template: string,
      frame: ArtifactPipelineFrame,
      additions: Readonly<Record<string, string>> = {},
    ) {
      return formatArtifactPipelineCopy(template, { ...this.values(frame), ...additions });
    }

    private announce(message: string, invalid: boolean) {
      const status = this.querySelector<HTMLElement>('[data-artifact-status]');
      this.dataset.valid = String(!invalid);
      if (!status) return;
      status.dataset.invalid = String(invalid);
      status.textContent = message;
    }

    private renderTargetPlanOptions(select: HTMLSelectElement) {
      const plans = getArtifactPipelineTargetPlans(this.state.lane);
      if (!plans.some(({ id }) => id === this.state.targetPlanId)) return false;
      select.replaceChildren(...plans.map((plan) => {
        const option = this.ownerDocument.createElement('option');
        option.value = plan.id;
        option.textContent = this.copy().targetPlans[plan.id].title;
        option.selected = plan.id === this.state.targetPlanId;
        return option;
      }));
      return true;
    }

    private render() {
      const result = deriveArtifactPipelineFrame(this.state);
      if (!result.accepted) {
        this.announce(this.copy().issues[result.issue], true);
        return undefined;
      }
      const frame = result.frame;
      const copy = this.copy();

      this.dataset.toolkitLane = frame.lane;
      this.dataset.targetPlan = frame.targetPlan.id;
      this.dataset.pipelineMode = frame.mode;
      this.dataset.stepIndex = String(frame.stepIndex);
      this.dataset.currentStage = frame.currentStage?.id ?? 'complete';
      this.dataset.sequenceComplete = String(frame.sequenceComplete);
      this.dataset.runtimeImageSelection = frame.manifest.runtimeImageSelection;
      this.dataset.valid = 'true';

      const lane = this.querySelector<HTMLSelectElement>('[data-artifact-lane]');
      const targetPlan = this.querySelector<HTMLSelectElement>('[data-artifact-target-plan]');
      const mode = this.querySelector<HTMLSelectElement>('[data-artifact-mode]');
      const step = this.querySelector<HTMLButtonElement>('[data-artifact-action="step"]');
      const reset = this.querySelector<HTMLButtonElement>('[data-artifact-action="reset"]');
      const focused = this.ownerDocument.activeElement;
      if (lane) lane.value = frame.lane;
      if (targetPlan) targetPlan.value = frame.targetPlan.id;
      if (mode) mode.value = frame.mode;
      if (step) step.disabled = frame.sequenceComplete;
      if (step && focused === step && step.disabled) reset?.focus();

      this.setText('[data-selection-summary]', `${frame.lane} · ${copy.targetPlans[frame.targetPlan.id].title} · ${copy.modes[frame.mode].title}`);
      this.setText('[data-selection-description]', `${copy.targetPlans[frame.targetPlan.id].description} ${copy.modes[frame.mode].description}`);
      this.setText('[data-manifest-lane]', frame.lane);
      this.setText('[data-manifest-mode]', copy.modes[frame.mode].title);
      this.setText('[data-manifest-scope]', copy.targetScopes[frame.targetPlan.targetScope]);
      this.setText('[data-manifest-virtual]', frame.manifest.virtualTarget);
      this.setText('[data-manifest-real]', frame.manifest.realTarget);
      const values = this.values(frame);
      this.setText('[data-manifest-ptx]', values.ptx);
      this.setText('[data-manifest-cubin]', values.cubin ? `${values.cubin} · SASS` : '');
      this.setText('[data-manifest-sources]', values.sourceInputs);
      this.setText('[data-manifest-objects]', values.hostObjects);
      this.setText('[data-manifest-device-link]', values.deviceLinkObject);
      this.setText('[data-manifest-final-inputs]', values.finalInputs);
      this.setText('[data-runtime-selection-value]', copy.runtimeSelectionUnknown);
      for (const field of this.querySelectorAll<HTMLElement>('[data-manifest-whole-program]')) {
        field.hidden = frame.manifest.pipelineMode !== 'whole-program';
      }

      for (const stage of frame.stages) {
        const item = this.querySelector<HTMLElement>(`[data-live-stage="${stage.id}"]`);
        if (!item) continue;
        item.dataset.stageIdentity = stage.identity;
        item.dataset.stageMode = stage.mode;
        item.dataset.branch = stage.branch;
        item.dataset.optional = String(stage.optional);
        item.dataset.stageState = stage.state;
        if (stage.state === 'current') item.setAttribute('aria-current', 'step');
        else item.removeAttribute('aria-current');
        this.setTextWithin(item, '[data-stage-branch-label]', copy.branchLabels[stage.branch]);
        this.setTextWithin(item, '[data-stage-label]', copy.modeStages[frame.mode][stage.id].label);
        this.setTextWithin(item, '[data-stage-description]', this.stageText(frame, stage.id, 'description'));
        this.setTextWithin(item, '[data-stage-artifact]', this.stageText(frame, stage.id, 'artifact'));
        this.setTextWithin(item, '[data-stage-state-label]', copy.stageStates[stage.state]);
      }

      return frame;
    }

    private stageText(
      frame: ArtifactPipelineFrame,
      stageId: ArtifactPipelineStageId,
      field: 'description' | 'artifact',
    ) {
      const copy = this.copy();
      const template = copy.modeStages[frame.mode][stageId][field];
      return this.format(template, frame);
    }

    private setText(selector: string, value: string) {
      const element = this.querySelector<HTMLElement>(selector);
      if (element) element.textContent = value;
    }

    private setTextWithin(root: ParentNode, selector: string, value: string) {
      const element = root.querySelector<HTMLElement>(selector);
      if (element) element.textContent = value;
    }
  }

  if (!customElements.get('cuda-artifact-pipeline')) {
    customElements.define('cuda-artifact-pipeline', CudaArtifactPipeline);
  }
</script>
