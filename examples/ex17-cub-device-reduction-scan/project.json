  "schemaVersion": 1,
  "id": "EX17",
  "title": "CUB Device Reduction and Scan",
  "purpose": "Exercise the legacy temporary-storage CUB DeviceReduce and DeviceScan APIs on fixed reduction and exact bounded-scan correctness contracts without making a timing claim.",
  "root": "examples/ex17-cub-device-reduction-scan",
  "sourceCommit": "0000000000000000000000000000000000000000",
  "sourceUrl": "https://github.com/xiangzhang-coding/cuda-learning-site/tree/0000000000000000000000000000000000000000/examples/ex17-cub-device-reduction-scan",
  "downloadUrl": "https://github.com/xiangzhang-coding/cuda-learning-site/archive/0000000000000000000000000000000000000000.zip",
  "license": "Apache-2.0",
  "provenance": "original",
  "build": {
    "standard": "c++17",
    "inputs": [
      "include/cub_device_reduction_scan_reference.hpp",
      "src/cub_device_reduction_scan.cu"
    ],
    "hostTestInputs": [
      "include/cub_device_reduction_scan_reference.hpp",
      "tests/host_reference_test.cpp"
    ],
    "contractFiles": [
      "Makefile",
      "scripts/compile-check.sh"
    ],
    "stages": [
      "preprocess",
      "compile",
      "link",
      "inspect"
    ],
    "commands": {
      "preprocess": "make preprocess DIALECT={dialect} BUILD_DIR=build COMPONENT_MODE={dependencyMode} EXPECTED_CUB_VERSION={expectedCubVersion}",
      "compile": "make compile DIALECT={dialect} BUILD_DIR=build COMPONENT_MODE={dependencyMode} EXPECTED_CUB_VERSION={expectedCubVersion}",
      "link": "make link DIALECT={dialect} BUILD_DIR=build COMPONENT_MODE={dependencyMode} EXPECTED_CUB_VERSION={expectedCubVersion}",
      "inspect": "make inspect DIALECT={dialect} BUILD_DIR=build COMPONENT_MODE={dependencyMode} EXPECTED_CUB_VERSION={expectedCubVersion}",
      "hostTest": "make host-test DIALECT={dialect} BUILD_DIR=build"
    },
    "artifacts": [
      "build/cub_device_reduction_scan.ii",
      "build/cub_device_reduction_scan.o",
      "build/ex17-cub-device-reduction-scan"
    ]
  },
  "correctness": {
    "cpuReference": "include/cub_device_reduction_scan_reference.hpp",
    "elementCount": 4099,
    "reduction": {
      "inputType": "float",
      "referenceType": "double",
      "absoluteTolerance": 0.0001,
      "relativeTolerance": 0.00002,
      "comparisonRule": "absolute_error <= absolute_tolerance + relative_tolerance * abs(cpu_reference)"
    },
    "scan": {
      "inputType": "uint32_t",
      "inputBounds": {
        "minimum": 0,
        "maximum": 7
      },
      "deterministicInputBounds": {
        "minimum": 1,
        "maximum": 7
      },
      "maximumPossibleTotal": 28693,
      "deterministicTotal": 16390,
      "references": [
        "inclusive_scan_reference",
        "exclusive_scan_reference"
      ],
      "comparison": "exact",
      "invariants": [
        "inclusive[0] = input[0] and inclusive[i] = inclusive[i - 1] + input[i]",
        "exclusive[0] = 0 and exclusive[i] = exclusive[i - 1] + input[i - 1]",
        "inclusive[last] = total and exclusive[last] + input[last] = total"
      ]
    }
  },
  "compatibility": {
    "supportedEnvironment": "Native Linux",
    "capabilityTier": "Baseline GPU Capability Tier",
    "minimumComputeCapability": "7.5",
    "fixedDeviceMemoryBytes": 65588,
    "temporaryStorage": "queried independently from each selected CUB primitive and version",
    "target": [
      "sm_75",
      "compute_75"
    ],
    "versionGate": {
      "header": "cub/version.cuh",
      "macro": "CUB_VERSION",
      "makeVariable": "EXPECTED_CUB_VERSION",
      "compileDefinition": "EX17_EXPECTED_CUB_VERSION"
    },
