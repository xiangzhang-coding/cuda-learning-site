  "correctness": {
    "formula": "y[i] = (x[i+1] - x[i])^2",
    "inputs": "Contiguous rank-one strided CPU/CUDA float32 or float64; 1 <= n <= 1000000; offset views allowed; no broadcasting or input mutation",
    "output": "Fresh contiguous length n-1 tensor on the same device and dtype",
    "cpuReference": "verify.py reference plus independently derived [9,16,0.25] literal",
    "gradients": "q=2*(x[1:]-x[:-1])*g; dx=pad_left(q)-pad_right(q), including n=1",
    "checks": ["CPU and CUDA reference", "nonuniform upstream gradient", "gradcheck", "gradgradcheck", "opcheck", "meta", "torch.compile fullgraph dynamic", "non-default CUDA stream", "fresh-process installed wheel import"]
