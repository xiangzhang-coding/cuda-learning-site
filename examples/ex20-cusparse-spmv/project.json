{
  "SPDX-License-Identifier": "Apache-2.0",
  "schemaVersion": 1,
  "id": "EX20",
  "title": "cuSPARSE SpMV",
  "purpose": "Check two original FP32 CSR matrix-vector products against a double CPU reference and literal results with explicit descriptors, scalars, workspace, stream completion, and component versions.",
  "root": "examples/ex20-cusparse-spmv",
  "license": "Apache-2.0",
  "provenance": "original",
  "build": {
    "standard": "c++17",
    "inputs": ["include/cusparse_spmv_reference.hpp", "src/cusparse_spmv.cu"],
    "hostTestInputs": ["include/cusparse_spmv_reference.hpp", "tests/host_reference_test.cpp"],
    "contractFiles": ["Makefile", "scripts/compile-check.sh"],
    "stages": ["preprocess", "compile", "link", "inspect"],
    "commands": {
      "preprocess": "make preprocess DIALECT={dialect} BUILD_DIR=build EXPECTED_CUSPARSE_VERSION={expectedCusparseVersion}",
      "compile": "make compile DIALECT={dialect} BUILD_DIR=build EXPECTED_CUSPARSE_VERSION={expectedCusparseVersion}",
      "link": "make link DIALECT={dialect} BUILD_DIR=build EXPECTED_CUSPARSE_VERSION={expectedCusparseVersion}",
      "inspect": "make inspect DIALECT={dialect} BUILD_DIR=build EXPECTED_CUSPARSE_VERSION={expectedCusparseVersion}",
      "hostTest": "make host-test DIALECT={dialect} BUILD_DIR=build"
    },
    "artifacts": ["build/cusparse_spmv.ii", "build/cusparse_spmv.o", "build/ex20-cusparse-spmv", "build/dynamic-section.txt", "build/dynamic-linkage.txt"]
  },
  "correctness": {
    "cpuReference": "include/cusparse_spmv_reference.hpp",
    "inputType": "float",
    "referenceType": "double",
    "precision": "FP32",
    "computeType": "CUDA_R_32F",
    "format": "CSR",
    "rows": 4,
    "columns": 5,
    "nnz": 7,
    "indexBase": 0,
    "indexType": "CUSPARSE_INDEX_32I",
    "rowOffsets": [0, 2, 2, 4, 7],
    "columnIndices": [0, 3, 1, 4, 0, 2, 4],
    "representation": "Zero-based 32-bit row offsets and column indices; columns are sorted and unique within each row; row 1 is empty",
    "operation": "CUSPARSE_OPERATION_NON_TRANSPOSE",
    "algorithm": "CUSPARSE_SPMV_CSR_ALG2",
    "pointerMode": "CUSPARSE_POINTER_MODE_HOST",
    "descriptorPolicy": "Mutable CSR and dense-vector descriptors reference caller-owned device arrays reused sequentially for both fixtures; all three lanes use the same API calls",
    "preprocessing": "No cusparseSpMV_preprocess call; the CUDA 11.8 lane does not provide it",
    "resetPolicy": "Reset device y from each fixture's initialY before every SpMV, including beta=0; never accumulate from a previous result",
    "absoluteTolerance": 0.0001,
    "relativeTolerance": 0.00002,
    "comparisonRule": "All four outputs and reference values must be finite and abs(gpu-cpu) <= 1e-4 + 2e-5*abs(cpu); the double CPU reference must also match the independent literal output",
    "fixtures": [
      {"id": "A", "values": [2,-1,3,4,-2,5,1], "x": [1,2,-1,3,2], "initialY": [4,-2,1,3], "alpha": 1, "beta": 0, "literalOutput": [-1,0,14,-5]},
      {"id": "B", "values": [-1,2,0.5,-3,4,-2,1], "x": [2,-1,3,0.5,-2], "initialY": [1,-4,2,0], "alpha": 2, "beta": -0.5, "literalOutput": [-2.5,2,10,0]}
    ]
  },
  "compatibility": {
    "supportedEnvironment": "Native Linux",
    "capabilityTier": "Baseline GPU Capability Tier",
    "minimumComputeCapability": "7.5",
    "fixedDeviceMemoryBytes": 112,
    "maximumProblemMemoryBytes": 8000000000,
    "temporaryStorage": "Query cusparseSpMV_bufferSize for each actual descriptor/scalar/operation/compute-type/algorithm contract; zero bytes skips allocation; caller arrays plus workspace are budget-checked; library internal resources are additional",
    "target": ["sm_75", "compute_75"],
    "versionGate": {
      "header": "cusparse.h",
      "macros": ["CUSPARSE_VER_MAJOR", "CUSPARSE_VER_MINOR", "CUSPARSE_VER_PATCH", "CUSPARSE_VER_BUILD"],
      "aggregateMacro": "CUSPARSE_VERSION = major*1000 + minor*100 + patch",
      "makeVariable": "EXPECTED_CUSPARSE_VERSION",
      "compileDefinitions": ["EX20_EXPECTED_CUSPARSE_MAJOR", "EX20_EXPECTED_CUSPARSE_MINOR", "EX20_EXPECTED_CUSPARSE_PATCH", "EX20_EXPECTED_CUSPARSE_BUILD"],
      "runtime": "cusparseGetProperty MAJOR_VERSION/MINOR_VERSION/PATCH_LEVEL must match header major/minor/patch; cusparseGetVersion(handle, ...) raw value is reported separately; loaded build is not exposed by these APIs"
    },
    "lanes": [
      {
        "id": "cuda-11.8", "toolkit": "11.8.0", "operatingSystem": "Ubuntu 22.04 x86-64",
