  "ranges": {
    "cpu-reference": {"file": "include/cusparse_spmv_reference.hpp", "startMarker": "// [ex20-cpu-reference-start]", "endMarker": "// [ex20-cpu-reference-end]", "language": "cpp"},
    "descriptors-workspace": {"file": "src/cusparse_spmv.cu", "startMarker": "// [ex20-descriptors-workspace-start]", "endMarker": "// [ex20-descriptors-workspace-end]", "language": "cpp"},
