  "schemaVersion": 1,
  "id": "EX18",
  "title": "cuBLAS GEMM Reference",
  "purpose": "Map EX15 row-major float fixtures to column-major cuBLAS GEMM and check every output against an independent double CPU oracle, without a performance claim.",
  "root": "examples/ex18-cublas-gemm",
  "license": "Apache-2.0",
  "provenance": "original",
  "build": {
    "standard": "c++17",
    "inputs": ["include/cublas_gemm_reference.hpp", "src/cublas_gemm.cu"],
    "hostTestInputs": ["include/cublas_gemm_reference.hpp", "tests/host_reference_test.cpp"],
    "contractFiles": ["Makefile", "scripts/compile-check.sh"],
    "stages": ["preprocess", "compile", "link", "inspect"],
    "commands": {
      "preprocess": "make preprocess DIALECT={dialect} BUILD_DIR=build EXPECTED_CUBLAS_VERSION={expectedCublasVersion}",
      "compile": "make compile DIALECT={dialect} BUILD_DIR=build EXPECTED_CUBLAS_VERSION={expectedCublasVersion}",
      "link": "make link DIALECT={dialect} BUILD_DIR=build EXPECTED_CUBLAS_VERSION={expectedCublasVersion}",
      "inspect": "make inspect DIALECT={dialect} BUILD_DIR=build EXPECTED_CUBLAS_VERSION={expectedCublasVersion}",
      "hostTest": "make host-test DIALECT={dialect} BUILD_DIR=build"
    },
    "artifacts": ["build/cublas_gemm.ii", "build/cublas_gemm.o", "build/ex18-cublas-gemm", "build/dynamic-section.txt", "build/dynamic-linkage.txt"]
  },
  "correctness": {
    "cpuReference": "include/cublas_gemm_reference.hpp",
    "inputType": "float",
    "referenceType": "double",
    "layout": "row-major",
    "operation": "C = alpha * A * B + beta * C",
    "computeType": "CUBLAS_COMPUTE_32F_PEDANTIC",
    "mathMode": "CUBLAS_DEFAULT_MATH",
    "matrixTypes": ["CUDA_R_32F", "CUDA_R_32F", "CUDA_R_32F"],
    "absoluteTolerance": 0.0001,
    "relativeTolerance": 0.00002,
    "comparisonRule": "finite full-output absolute_error <= absolute_tolerance + relative_tolerance * abs(cpu_reference)",
    "fixtures": [
      {"id": "2x3x2-hand", "m": 2, "k": 3, "n": 2, "alpha": 1, "beta": 0, "literalExpected": [22, 28, 49, 64]},
      {"id": "33x31x35-partial", "m": 33, "k": 31, "n": 35, "alpha": 0.75, "beta": 0.25},
      {"id": "32x32x32-aligned", "m": 32, "k": 32, "n": 32, "alpha": 1, "beta": 0}
    ]
  },
  "compatibility": {
    "supportedEnvironment": "Native Linux",
    "capabilityTier": "Baseline GPU Capability Tier",
    "minimumComputeCapability": "7.5",
    "fixedDeviceMemoryBytes": 13056,
    "maximumProblemMemoryBytes": 8000000000,
    "temporaryStorage": "cuBLAS-owned default workspace pool; not included in fixed matrix bytes",
    "target": ["sm_75", "compute_75"],
    "versionGate": {
      "header": "cublas_v2.h",
