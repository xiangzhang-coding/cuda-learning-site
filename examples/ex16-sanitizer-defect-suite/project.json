  "correctness": {
    "hostUtility": "tests/host_utility_test.cpp",
    "hostUtilityScope": "scenario, command, and category metadata only; it cannot establish GPU correctness or sanitizer behavior",
    "processBoundary": "one case per executable and one executable per process",
    "scenarios": [
      {
        "id": "memcheck",
        "tool": "memcheck",
        "defectSource": "src/memcheck_defect.cu",
        "correctedSource": "src/memcheck_corrected.cu",
        "category": "global-memory-out-of-bounds",
        "maximumProblemMemoryBytes": 128
      },
      {
        "id": "racecheck",
        "tool": "racecheck",
        "defectSource": "src/racecheck_defect.cu",
        "correctedSource": "src/racecheck_corrected.cu",
        "category": "shared-memory-raw-hazard",
        "maximumProblemMemoryBytes": 8
      },
      {
        "id": "initcheck",
        "tool": "initcheck",
        "defectSource": "src/initcheck_defect.cu",
        "correctedSource": "src/initcheck_corrected.cu",
        "category": "uninitialized-global-memory-read",
        "maximumProblemMemoryBytes": 128
      },
      {
        "id": "synccheck",
        "tool": "synccheck",
        "defectSource": "src/synccheck_defect.cu",
        "correctedSource": "src/synccheck_corrected.cu",
        "category": "divergent-block-barrier",
        "maximumProblemMemoryBytes": 128
      }
    ]
  },
  "compatibility": {
