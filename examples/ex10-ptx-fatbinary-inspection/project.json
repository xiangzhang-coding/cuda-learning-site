          "tag": "ex10-cuda-13-3-gcc14-cxx23-probe:local",
          "buildCommand": "docker build --platform linux/amd64 --file examples/ex10-ptx-fatbinary-inspection/probes/cuda-13.3-gcc14.Dockerfile --tag ex10-cuda-13-3-gcc14-cxx23-probe:local examples/ex10-ptx-fatbinary-inspection"
        },
        "commands": [
          "nvcc --compiler-bindir=/usr/bin/g++-14 --std=c++23 --generate-code=arch=compute_75,code=sm_75 --generate-code=arch=compute_75,code=compute_75 --compile probes/cxx23.cu -o build/cxx23_probe.o",
