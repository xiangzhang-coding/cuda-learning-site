{
  "name": "cuda-learning-site",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "build": "astro build",
    "build:release": "npm run quality:source && npm run quality:dependencies && npm run quality:licenses && npm run quality:canonical-imports && npm run check && npm run test:unit && npm run build && npm run test:integration && npm run quality:dist",
    "check": "astro check",
    "dev": "astro dev",
    "preview": "astro preview",
    "quality:artifacts": "node scripts/check-artifacts.mjs",
    "quality:canonical-imports": "node scripts/check-canonical-imports.mjs",
    "quality:dependencies": "node scripts/check-lockfile.mjs",
    "quality:dist": "node scripts/check-artifacts.mjs dist",
    "quality:licenses": "node scripts/check-file-licenses.mjs",
    "quality:source": "node scripts/check-source.mjs",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:accessibility": "playwright test --project=chromium --grep @accessibility",
    "test:e2e:chromium": "playwright test --project=chromium --grep-invert \"@accessibility|@visual\"",
    "test:e2e:cross-browser": "playwright test --project=firefox --project=webkit --project=mobile-safari --grep-invert \"@accessibility|@visual\"",
    "test:e2e:visual": "playwright test --project=chromium --grep @visual",
    "test:integration": "vitest run tests/integration",
    "test:unit": "vitest run tests/unit --coverage"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.4",
    "@astrojs/mdx": "7.0.7",
    "@astrojs/starlight": "0.41.7",
    "astro": "7.2.4",
    "pagefind": "1.5.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "linkedom": "0.18.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
